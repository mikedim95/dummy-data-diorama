Project WAM {
  database_type: 'PostgreSQL'
  Note: '''WAM v4. One database, 25 tables, the original four groups.
  Accounts and audit history support accountability. MAINTENANCE_PLAN supplies operator tips and calendar reminders.
  New orders require approval of the exact template revision before production; existing migrated orders retain their eligibility.
  One order = one product/design and one ordered quantity.
  Each JOB is a production step for that quantity; step quantities are never added together.
  TEMPLATE rows are immutable revisions. JOB_MATERIAL is the plan; STOCK_MOVEMENT is actual usage.
  STOCK_BALANCE is maintained from movements, including opening stock.
  Row checks, cross-table workflow rules and stock posting are implemented in the companion PostgreSQL SQL file.'''
}

// 1. PEOPLE & ORGANIZATION — BLUE

Table EMPLOYEE [headercolor: #3B82F6] {
  id uuid [pk, default: `gen_random_uuid()`]
  full_name varchar(150) [not null]
  email varchar(255) [unique]
  job_title varchar(100)
  is_active boolean [not null, default: true]
  employee_code varchar(40) [not null, note: 'Unique code generated by the SQL employee sequence.']
  employment_start_date date
  employment_end_date date

  indexes {
    employee_code [unique, name: 'uq_employee_code']
  }

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table DEPARTMENT [headercolor: #3B82F6] {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  manager_id uuid [note: 'Optional responsible employee; department membership is stored separately.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table EMPLOYEE_DEPARTMENT [headercolor: #3B82F6] {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  department_id uuid [not null]
  department_role varchar(100)

  indexes {
    (employee_id, department_id) [unique, name: 'uq_employee_department_employee_department']
    department_id [name: 'idx_employee_department_department']
  }
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table ATTENDANCE [headercolor: #3B82F6] {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  attendance_date date [not null, default: `(now() AT TIME ZONE 'Europe/Athens')::date`, note: 'Athens workday; overnight attendance belongs to the check-in date.']
  status varchar(30) [not null, default: 'PRESENT', note: 'PRESENT, ABSENT, LEAVE, SICK_LEAVE, DAY_OFF. Missing row means not recorded.']
  check_in_at timestamptz [note: 'Optional arrival time, only for PRESENT.']
  check_out_at timestamptz [note: 'Optional departure time; requires arrival and must be later. Overnight attendance is supported.']
  notes text
  recorded_by_employee_id uuid [not null, note: 'Employee who last entered or corrected the record; authorized by the API.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (employee_id, attendance_date) [unique, name: 'uq_attendance_employee_date']
    (attendance_date, status) [name: 'idx_attendance_date_status']
    recorded_by_employee_id [name: 'idx_attendance_recorded_by']
  }

  Note: 'Simple daily attendance register (parousiologio). One employee per workday. PRESENT may have no times. Check-in date must match the Athens workday. Hours between arrival and departure measure elapsed presence; payroll, split shifts and per-job time tracking are outside this table. SQL enforces checks and updates timestamps.'
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

// 2. CUSTOMERS & PRODUCTION — GREEN

Table CUSTOMER [headercolor: #22C55E] {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(180) [not null]
  contact_name varchar(150)
  phone varchar(40)
  email varchar(255)
  notes text

  indexes {
    name [name: 'idx_customer_name']
    phone [name: 'idx_customer_phone']
  }
  is_active boolean [not null, default: true, note: 'Archive instead of deleting referenced history.']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table TEMPLATE [headercolor: #22C55E] {
  id uuid [pk, default: `gen_random_uuid()`]
  template_code varchar(60) [not null, note: 'Same code across revisions; each revision has its own UUID.']
  name varchar(180) [not null]
  revision int [not null, default: 1]
  design_file varchar(500) [not null, note: 'Immutable NAS file for this revision; never overwrite.']
  design_checksum char(64) [not null, note: 'Lowercase SHA-256 of the preserved file.']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (template_code, revision) [unique, name: 'uq_template_code_revision']
  }

  Note: 'An inserted row is an immutable design revision. Insert a new revision instead of updating or deleting it.'
}

Table CUSTOMER_ORDER [headercolor: #22C55E] {
  id uuid [pk, default: `gen_random_uuid()`]
  order_number varchar(40) [not null, unique, note: 'Readable reference supplied by the app, e.g. WAM-2026-000123.']
  title varchar(180) [not null]
  customer_id uuid [not null]
  template_id uuid [note: 'May be empty at intake; references one exact immutable revision.']
  intake_employee_id uuid [not null]
  designer_id uuid
  qc_employee_id uuid
  special_requests text
  quantity int [not null, default: 1]
  status varchar(30) [not null, default: 'SUBMITTED']
  qc_result varchar(20) [not null, default: 'NOT_CHECKED']
  qc_notes text
  qc_checked_at timestamptz
  submitted_at timestamptz [not null, default: `now()`]
  due_at timestamptz
  delivered_at timestamptz
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_id, submitted_at) [name: 'idx_customer_order_customer_submitted']
    (status, due_at) [name: 'idx_customer_order_status_due']
    template_id [name: 'idx_customer_order_template']
  }

  Note: 'Main flow: SUBMITTED > PLANNED > IN_PRODUCTION > QC > READY > DELIVERED. Failed QC returns to production with new appended rework steps. Completed work is preserved.'
  approval_required boolean [not null, default: true, note: 'Existing migrated orders are false; new orders default true. API restricts overrides to managers.']
  approved_template_id uuid
  customer_approved_at timestamptz
  approved_by_contact varchar(180)
  approval_document_id uuid
  cancelled_at timestamptz
  cancellation_reason text

  created_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table JOB [headercolor: #22C55E] {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  sequence_no int [not null]
  name varchar(180) [not null]
  responsible_employee_id uuid
  machine_id uuid [note: 'Empty for a manual step.']
  completed_quantity int [not null, default: 0, note: 'Good units completed in THIS step. Target is CUSTOMER_ORDER.quantity.']
  schematic_file varchar(500) [note: 'Exact preserved approved working file; optional for steps without a file.']
  schematic_revision varchar(50)
  schematic_checksum char(64)
  status varchar(30) [not null, default: 'PENDING']
  started_at timestamptz
  completed_at timestamptz
  notes text
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (order_id, sequence_no) [unique, name: 'uq_job_order_sequence']
    (responsible_employee_id, status) [name: 'idx_job_employee_status']
    machine_id [name: 'idx_job_machine']
  }

  Note: 'A sequential production step for the full order quantity. Start after preceding steps complete. Completed steps are immutable. Rework is a new later step.'
  created_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table JOB_MATERIAL [headercolor: #22C55E] {
  id uuid [pk, default: `gen_random_uuid()`]
  job_id uuid [not null]
  material_id uuid [not null]
  planned_quantity numeric(14,3) [not null, note: 'Planned requirement in MATERIAL.unit, not actual usage.']
  unit_cost numeric(14,4) [note: 'EUR per MATERIAL.unit, captured for this job plan.']

  indexes {
    (job_id, material_id) [unique, name: 'uq_job_material_job_material']
    material_id [name: 'idx_job_material_material']
  }
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

// 3. MACHINES, ASSETS & INVENTORY — ORANGE

Table LOCATION [headercolor: #F97316] {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(150) [not null, unique, note: 'Use a clear full name, e.g. Warehouse A / Shelf 03.']
  type varchar(60) [note: 'Warehouse, room, shelf, workshop.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table MACHINE [headercolor: #F97316] {
  id uuid [pk, default: `gen_random_uuid()`]
  location_id uuid
  supplier_id uuid
  name varchar(160) [not null]
  serial_number varchar(160) [unique]
  type varchar(100)
  status varchar(30) [not null, default: 'ACTIVE']
  purchase_price numeric(12,2) [note: 'EUR.']

  Note: 'Production equipment. Accessories and independent tools belong in ASSET; do not duplicate a machine there.'
  equipment_code varchar(40) [not null, note: 'Unique internal equipment label; generated by SQL.']
  purchase_date date
  warranty_expires_on date

  indexes {
    equipment_code [unique, name: 'uq_machine_equipment_code']
  }

  is_active boolean [not null, default: true, note: 'Archive instead of deleting referenced history.']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table MACHINE_MAINTENANCE [headercolor: #F97316] {
  id uuid [pk, default: `gen_random_uuid()`]
  machine_id uuid [not null]
  maintenance_type varchar(30) [not null, default: 'PREVENTIVE', note: 'PREVENTIVE, CORRECTIVE, INSPECTION.']
  title varchar(180) [not null, note: 'Brief description of the work completed.']
  performed_at timestamptz [not null, default: `now()`]
  performed_by_employee_id uuid [note: 'Internal technician; supply an employee and/or an external supplier.']
  supplier_id uuid [note: 'External maintenance provider, using the existing SUPPLIER table.']
  next_due_date date [note: 'Optional next service date, on or after the service workday in Athens.']
  notes text
  recorded_by_employee_id uuid [not null, note: 'Employee who last entered or corrected this record; authorized by the API.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (plan_id, performed_at) [name: 'idx_maintenance_plan_history']
    request_key [unique, name: 'uq_maintenance_request_key']
    (machine_id, performed_at) [name: 'idx_maintenance_machine_performed']
    next_due_date [name: 'idx_maintenance_next_due']
    performed_by_employee_id [name: 'idx_maintenance_employee']
    supplier_id [name: 'idx_maintenance_supplier']
    recorded_by_employee_id [name: 'idx_maintenance_recorded_by']
  }

  Note: 'Completed machine service history. Record the internal employee and/or external supplier. Attach service reports and receipts through DOCUMENT_LINK. For a simple due list, use the latest record per machine and maintenance type. Machine operating status is managed separately.'
  plan_id uuid [note: 'Optional originating maintenance plan; SQL validates machine/type and advances its reminder.']

  request_key uuid [note: 'Required for plan completion. Reuse this idempotency key on every retry.']

  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table SUPPLIER [headercolor: #F97316] {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(180) [not null]
  contact_name varchar(150)
  phone varchar(40)
  email varchar(255)
  notes text
  is_active boolean [not null, default: true, note: 'Archive instead of deleting referenced history.']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table ASSET [headercolor: #F97316] {
  id uuid [pk, default: `gen_random_uuid()`]
  machine_id uuid [note: 'Attached to this machine; its location is inherited from MACHINE.']
  location_id uuid [note: 'Own storage location only when not attached to a machine.']
  supplier_id uuid
  name varchar(160) [not null]
  serial_number varchar(160) [unique]
  category varchar(80)
  purchase_price numeric(12,2) [note: 'EUR.']
  equipment_code varchar(40) [not null, note: 'Unique internal equipment label; generated by SQL.']
  purchase_date date
  warranty_expires_on date

  indexes {
    equipment_code [unique, name: 'uq_asset_equipment_code']
  }

  is_active boolean [not null, default: true, note: 'Archive instead of deleting referenced history.']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table MATERIAL [headercolor: #F97316] {
  id uuid [pk, default: `gen_random_uuid()`]
  material_code varchar(60) [not null, unique]
  name varchar(160) [not null]
  type varchar(30) [not null]
  unit varchar(20) [not null, note: 'One canonical unit for stock, planned requirements and supplier prices; immutable after use.']
  standard_unit_cost numeric(14,4) [note: 'Reference EUR cost per canonical unit; supplier quotes and job snapshots are separate.']
  min_stock numeric(14,3) [not null, default: 0]
  is_active boolean [not null, default: true, note: 'Archive instead of deleting referenced history.']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table SUPPLIER_MATERIAL [headercolor: #F97316] {
  id uuid [pk, default: `gen_random_uuid()`]
  supplier_id uuid [not null]
  material_id uuid [not null]
  unit_price numeric(14,4) [note: 'Quoted EUR price per MATERIAL.unit; normalize pack prices before saving.']

  indexes {
    (supplier_id, material_id) [unique, name: 'uq_supplier_material_supplier_material']
    material_id [name: 'idx_supplier_material_material']
  }
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table MACHINE_MATERIAL [headercolor: #F97316] {
  id uuid [pk, default: `gen_random_uuid()`]
  machine_id uuid [not null]
  material_id uuid [not null]
  purpose varchar(255)

  indexes {
    (machine_id, material_id) [unique, name: 'uq_machine_material_machine_material']
    material_id [name: 'idx_machine_material_material']
  }

  Note: 'Compatibility or normal use. This link does not consume stock.'
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table STOCK_BALANCE [headercolor: #F97316] {
  id uuid [pk, default: `gen_random_uuid()`]
  material_id uuid [not null]
  location_id uuid [not null]
  quantity numeric(14,3) [not null, default: 0]

  indexes {
    (material_id, location_id) [unique, name: 'uq_stock_balance_material_location']
    location_id [name: 'idx_stock_balance_location']
  }

  Note: 'Current physical stock, maintained only by the PostgreSQL stock-posting trigger. Opening stock is an ADJUSTMENT movement. Planning does not reserve stock.'
}

Table STOCK_MOVEMENT [headercolor: #F97316] {
  id uuid [pk, default: `gen_random_uuid()`]
  request_key uuid [not null, unique, note: 'Caller-generated idempotency key; reuse the same key on a retry.']
  material_id uuid [not null]
  from_location_id uuid
  to_location_id uuid
  job_id uuid [note: 'Required for RETURN; set for production CONSUMPTION. Empty for general consumable usage.']
  financial_record_id uuid [note: 'Optional purchase/expense reference; may be attached after receipt.']
  quantity numeric(14,3) [not null]
  movement_type varchar(30) [not null]
  reason text
  performed_by_employee_id uuid [not null]
  movement_date timestamptz [not null, default: `now()`]

  indexes {
    (material_id, movement_date) [name: 'idx_stock_movement_material_date']
    (job_id, material_id) [name: 'idx_stock_movement_job_material']
    financial_record_id [name: 'idx_stock_movement_financial_record']
  }

  Note: 'Posted quantities and endpoints are immutable. Correct counts with reasoned adjustments; return unused job material with RETURN. Actual job usage = CONSUMPTION minus RETURN. Only finance linkage and reason text may be edited.'
}

// 4. DOCUMENTS & FINANCE — PURPLE

Table FINANCIAL_RECORD [headercolor: #A855F7] {
  id uuid [pk, default: `gen_random_uuid()`]
  reference_number varchar(100) [note: 'External invoice or receipt number; not globally unique across suppliers.']
  customer_order_id uuid [note: 'For order-related sales; derive the customer through the order.']
  customer_id uuid [note: 'For customer transactions without an order; leave empty when customer_order_id is set.']
  supplier_id uuid
  original_record_id uuid [note: 'Mandatory for a refund; points to the original sale, purchase or expense.']
  type varchar(30) [not null]
  category varchar(80)
  amount numeric(12,2) [not null, note: 'Positive gross total, including any tax; refund direction follows type.']
  paid_amount numeric(12,2) [not null, default: 0, note: 'Cumulative settled amount. Payment status is derived from this and amount.']
  currency char(3) [not null, default: 'EUR']
  record_date date [not null]
  due_date date
  notes text

  indexes {
    customer_order_id [name: 'idx_financial_record_order']
    (supplier_id, record_date) [name: 'idx_financial_record_supplier_date']
    (customer_id, record_date) [name: 'idx_financial_record_customer_date']
    original_record_id [name: 'idx_financial_record_original']
  }

  Note: 'Basic invoice/expense register. UNPAID when paid_amount = 0, PAID when paid_amount = amount, otherwise PARTIALLY_PAID. Several records may reference one order. Refunds must match the original party and currency and cannot exceed its total.'
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table DOCUMENT [headercolor: #A855F7] {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(255) [not null]
  category varchar(80) [note: 'TECHNICAL, FINANCIAL, LOGISTICS, etc.']
  file_path varchar(500) [not null, unique, note: 'One canonical NAS file path; one file can have many DOCUMENT_LINK rows.']
  visibility varchar(30) [not null, default: 'INTERNAL']
  uploaded_by_employee_id uuid [not null]
  uploaded_at timestamptz [not null, default: `now()`]

  Note: 'Visibility is a classification. The application must enforce access, and NAS permissions must agree.'
  original_filename varchar(255)
  mime_type varchar(150)
  file_size_bytes bigint
  file_checksum char(64) [note: 'Optional lowercase SHA-256 verified from actual file bytes.']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}

Table DOCUMENT_LINK [headercolor: #A855F7] {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null]
  machine_id uuid
  asset_id uuid
  material_id uuid
  supplier_id uuid
  customer_order_id uuid
  job_id uuid
  template_id uuid
  financial_record_id uuid
  maintenance_id uuid

  indexes {
    (document_id, maintenance_plan_id) [unique, name: 'uq_document_link_maintenance_plan']
    (document_id, machine_id) [unique, name: 'uq_document_link_machine']
    (document_id, asset_id) [unique, name: 'uq_document_link_asset']
    (document_id, material_id) [unique, name: 'uq_document_link_material']
    (document_id, supplier_id) [unique, name: 'uq_document_link_supplier']
    (document_id, customer_order_id) [unique, name: 'uq_document_link_order']
    (document_id, job_id) [unique, name: 'uq_document_link_job']
    (document_id, template_id) [unique, name: 'uq_document_link_template']
    (document_id, financial_record_id) [unique, name: 'uq_document_link_financial_record']
    (document_id, maintenance_id) [unique, name: 'uq_document_link_maintenance']
  }

  Note: 'One target per row. Link the same service receipt to maintenance, its machine, and finance using separate rows, without copying the file.'
  maintenance_plan_id uuid

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1, note: 'Use in conditional updates; SQL increments this on every update.']

}


Table USER_ACCOUNT [headercolor: #3B82F6] {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  auth_provider varchar(80) [not null]
  auth_subject varchar(255) [not null]
  role varchar(30) [not null, default: 'VIEWER', note: 'ADMIN, MANAGER, OFFICE, PRODUCTION, FINANCE, VIEWER. API enforces permissions.']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1]
  indexes {
    employee_id [unique, name: 'uq_user_account_employee']
    (auth_provider, auth_subject) [unique, name: 'uq_user_account_provider_subject']
  }
  Note: 'External authentication identity, one account per employee. No stored passwords. An employee can exist without an account.'
}

Table AUDIT_LOG [headercolor: #A855F7] {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_user_id uuid [note: 'Trusted API supplies transaction-local actor identity; empty means system or unattributed.']
  entity_type varchar(64) [not null]
  entity_id uuid [not null, note: 'Historical row identifier; deliberately not a polymorphic foreign key.']
  action varchar(10) [not null, note: 'INSERT, UPDATE, DELETE.']
  changed_columns text[] [not null]
  before_data jsonb
  after_data jsonb
  change_reason text
  occurred_at timestamptz [not null, default: `now()`]
  indexes {
    (entity_type, entity_id, occurred_at) [name: 'idx_audit_entity_time']
    (actor_user_id, occurred_at) [name: 'idx_audit_actor_time']
    occurred_at [name: 'idx_audit_occurred_at']
  }
  Note: 'Append-only changes generated by SQL triggers, with redacted contact/auth/free-text snapshots. Read access is restricted by the application. Migration does not invent past events.'
}

Table MAINTENANCE_PLAN [headercolor: #F97316] {
  id uuid [pk, default: `gen_random_uuid()`]
  machine_id uuid [not null]
  title varchar(180) [not null]
  maintenance_type varchar(30) [not null, default: 'PREVENTIVE']
  instructions text [not null, note: 'Machine-specific, approved operator instructions.']
  interval_days int [note: 'Positive calendar days after actual service completion; empty for a one-off reminder or evergreen tip.']
  next_due_date date [note: 'Required for recurring plans. Empty with no interval means an evergreen operator tip.']
  remind_before_days int [not null, default: 3]
  last_completed_at timestamptz [note: 'Maintained from linked service history.']
  assigned_employee_id uuid
  display_to_operator boolean [not null, default: true]
  operator_can_complete boolean [not null, default: false, note: 'API must enforce this; complex service stays with authorized technicians.']
  requires_machine_stop boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_by_employee_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  record_version int [not null, default: 1]
  indexes {
    (machine_id, is_active) [name: 'idx_maintenance_plan_machine']
    next_due_date [name: 'idx_maintenance_plan_due']
    assigned_employee_id [name: 'idx_maintenance_plan_assignee']
    created_by_employee_id [name: 'idx_maintenance_plan_creator']
  }
  Note: 'One independent task per machine: routine checks, service, inspection, or evergreen guidance. Linked maintenance entries advance recurring reminders atomically. OPERATOR_MAINTENANCE SQL view exposes TIP, OVERDUE, DUE_TODAY, UPCOMING, SCHEDULED.'
}

