# Local sample setup. These logins are disabled in production.
WAM_LOCAL_DEMO=true
WAM_LOCAL_PIN=1234
WAM_DATA_DIR=.data/wam
WAM_UPLOAD_DIR=.data/uploads

# Set this to use an external PostgreSQL database instead of local PGlite.
# DATABASE_URL=postgres://wam:replace-me@127.0.0.1:5432/wam

# Cloud authentication: also configure matching VITE_SUPABASE_* browser values.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
